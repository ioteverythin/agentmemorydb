# ======================
# EngramDB Configuration
# ======================

# Application
APP_NAME=EngramDB
ENVIRONMENT=development
LOG_LEVEL=INFO
ENABLE_DOCS=true

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://agentmem:agentmem_secret@localhost:5432/agentmemorydb
DATABASE_ECHO=false

# Embedding settings
EMBEDDING_DIMENSION=1536
VECTOR_INDEX_LISTS=100

# Retrieval defaults
DEFAULT_TOP_K=10

# Optional: OpenAI (only needed if using OpenAI embedding provider)
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embedding provider: dummy | openai | cohere | sentence-transformers | ollama
EMBEDDING_PROVIDER=dummy

# Authentication
REQUIRE_AUTH=false

# Feature flags
ENABLE_WEBHOOKS=true
ENABLE_METRICS=true
ENABLE_FULLTEXT_SEARCH=true
ENABLE_ACCESS_TRACKING=true

# WebSocket / MCP / Explorer / Scheduler
ENABLE_WEBSOCKET=true
ENABLE_MCP=true
ENABLE_EXPLORER=true
ENABLE_SCHEDULER=true

# Row Level Security (run migration 004_add_rls first)
ENABLE_RLS=false

# Scheduler intervals (seconds)
# SCHEDULER_CONSOLIDATION_INTERVAL=3600
# SCHEDULER_ARCHIVE_INTERVAL=7200
# SCHEDULER_RECENCY_INTERVAL=1800
# SCHEDULER_CLEANUP_INTERVAL=3600
# SCHEDULER_PRUNE_INTERVAL=86400
# SCHEDULER_STALE_THRESHOLD_DAYS=90
# SCHEDULER_ACCESS_LOG_RETENTION_DAYS=90

# ── Temporal validity (bitemporal facts) ─────────────────────────
# When true, retrieval defaults to currently-valid facts only (valid_to IS NULL).
# When false (default), behaviour is identical to pre-007: an open future window
# still counts as current. `as_of` point-in-time queries work either way.
ENABLE_TEMPORAL_VALIDITY=false

# ── Contradiction detection ──────────────────────────────────────
# Resolve conflicts at promotion time instead of letting stale facts coexist.
ENABLE_CONTRADICTION_DETECTION=false
CONTRADICTION_STRATEGY=heuristic          # heuristic | llm
CONTRADICTION_SIMILARITY_THRESHOLD=0.85
CONTRADICTION_CANDIDATE_TOP_K=5

# ── Auditable forgetting: decay, reconsolidation, erasure ────────
# See docs/forgetting.md. All destructive behaviour is off by default; the
# default DELETE /memories/{id} archives rather than erases.
ENABLE_DECAY=false                         # importance decays since last use
DECAY_HALF_LIFE_HOURS=720                  # 30 days — a true half-life
DECAY_FLOOR=0.05                           # decay never removes a memory
SCHEDULER_ENABLE_DECAY=true                # register the job (still needs ENABLE_DECAY)
SCHEDULER_DECAY_INTERVAL=21600             # 6h
ENABLE_RECONSOLIDATION=false               # recall strengthens a memory
RECONSOLIDATION_BOOST=0.02                 # per-recall importance bump, capped at 1.0
# Expose the irreversible `forget_memory` MCP tool. Even when true, the calling
# API key must still carry the `erase` scope.
MCP_ENABLE_FORGET=false

# ── LLM provider (optional: powers `llm` strategies + reflection) ─
LLM_PROVIDER=none                          # none | openai
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=                            # for an OpenAI-compatible gateway
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30
